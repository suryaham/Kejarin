# Google Gemini API (server-side only, jangan expose ke client)
# Dapatkan API key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Database (Postgres — Vercel Postgres / Neon / lainnya)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Twilio WhatsApp API (butuh akun Twilio berbayar + WhatsApp Sender terverifikasi)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Nomor WhatsApp Sender pengirim (format internasional tanpa "whatsapp:", mis. 14155238886)
TWILIO_WHATSAPP_FROM=
# Content SID template WhatsApp (dari Twilio Content Template Builder, diawali "HX...")
TWILIO_TEMPLATE_SID_H1=
TWILIO_TEMPLATE_SID_OVERDUE=

# Secret untuk melindungi endpoint /api/cron/reminder (dicocokkan dengan header
# "Authorization: Bearer <CRON_SECRET>" yang dikirim Vercel Cron Job)
CRON_SECRET=
